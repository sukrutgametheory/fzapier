# Supabase Configuration
# These are automatically set in local development and production
SUPABASE_URL=your-project-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Wati API Configuration
WATI_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
WATI_BASE_URL=https://live-mt-server.wati.io/429482

# Email Service Configuration (for Calendar Invites)
# Choose ONE: Either AWS SES or Resend

# Option 1: AWS SES (if you have AWS SMTP configured)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
USE_AWS_SES=true

# Option 2: Resend (simpler alternative)
# RESEND_API_KEY=re_...

# Email sender details (used by both options)
EMAIL_FROM_ADDRESS=bookings@gametheory.in
EMAIL_FROM_NAME=Game Theory Bookings
